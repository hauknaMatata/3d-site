# ---- AI 3D Studio backend configuration --------------------------------------------------------
# REQUIRED in production: master secret used to encrypt AI provider API keys and MCP headers at rest.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional shared access token. When set, every API/WebSocket/MCP request must send
# "Authorization: Bearer <API_TOKEN>" (the web UI stores it in Settings → Connection).
API_TOKEN=

# Comma-separated list of allowed browser origins (your frontend URL).
CORS_ORIGINS=http://localhost:5173,https://<user>.github.io

# Where SQLite, uploads, renders and exports are stored (mount a persistent volume here).
DATA_DIR=./data

# Delay between LIVE BUILD steps (s) so every real operation is visible in the viewport.
LIVE_BUILD_STEP_DELAY=0.35
MAX_UPLOAD_MB=20
ASSIMP_BIN=assimp

# AI provider keys are NOT configured here: add them in the web UI (Settings → AI models);
# they are stored encrypted with SECRET_KEY on the server and never sent to the browser.
